[Unit]
Description=BeaconWatch APRS-IS receiver and map service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bret
Group=www-data
WorkingDirectory=/opt/beaconwatch
Environment=PYTHONUNBUFFERED=1
Environment=BEACONWATCH_DATABASE=/var/lib/beaconwatch/locations.db
Environment=BEACONWATCH_LISTEN_HOST=127.0.0.1
Environment=BEACONWATCH_LISTEN_PORT=20242
Environment=BEACONWATCH_APRS_LOGIN=K6BAT-15
ExecStart=/usr/bin/python3 /opt/beaconwatch/beaconwatch.py
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/beaconwatch
RestrictAddressFamilies=AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
