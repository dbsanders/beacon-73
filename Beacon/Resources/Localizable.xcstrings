    "A suffix from 0–15 that distinguishes this phone from your other APRS stations. Zero sends only your base call sign." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于区分这部设备和您其他 APRS 电台的后缀，范围为 0–15。选 0 时，只发送基本呼号。"
          }
        }
      }
    },
