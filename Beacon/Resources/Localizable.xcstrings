    },
    "The APRS-IS passcode does not match %@. Check the call sign and passcode in Settings. Receiving remains available, but transmitting is disabled." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "APRS-IS 密码与呼号 %@ 不匹配。请在设置中检查呼号和密码。仍可接收信号，但无法发送。"
          }
        }
      }
    },
    "The APRS-IS validation number derived from your call sign. It is not your FCC or website password." : {
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是一组根据您的呼号生成的 APRS-IS 数字密码，与您的 FCC 账号密码或其他网站的登录密码无关。"
          }
        }
      }
    },
    "The App Store couldn’t verify this tip. No contribution was recorded." : {
      "localizations" : {
        "zh-Hans" : {
